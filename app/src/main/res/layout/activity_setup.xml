<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0A1628" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:padding="28dp" android:paddingTop="60dp" android:paddingBottom="40dp">
        <TextView android:text="🕌" android:textSize="56sp" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>
        <TextView android:text="نماز ٹریکر" android:textSize="26sp" android:textStyle="bold"
            android:textColor="#7AB8FF" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
        <TextView android:text="BJNT Karachi" android:textSize="12sp"
            android:textColor="#5A7FA8" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"/>
        <LinearLayout android:id="@+id/step1" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="Activation Code درج کریں" android:textSize="14sp"
                android:textColor="#A8C4F0" android:gravity="center"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
            <EditText android:id="@+id/codeInput" android:layout_width="match_parent"
                android:layout_height="52dp" android:background="@drawable/input_bg"
                android:textColor="#FFFFFF" android:textColorHint="#5A7FA8"
                android:hint="activation code" android:textSize="16sp"
                android:inputType="text" android:gravity="center" android:padding="14dp"
                android:layout_marginBottom="16dp"/>
            <Button android:id="@+id/verifyBtn" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="Verify کریں"
                android:background="@drawable/btn_primary" android:textColor="#FFFFFF"
                android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/step2" android:orientation="vertical"
            android:visibility="gone" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView android:text="اپنا نام لکھیں" android:textSize="14sp"
                android:textColor="#A8C4F0" android:gravity="center"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
            <EditText android:id="@+id/nameInput" android:layout_width="match_parent"
                android:layout_height="52dp" android:background="@drawable/input_bg"
                android:textColor="#FFFFFF" android:textColorHint="#5A7FA8"
                android:hint="Muhammad Usman" android:textSize="16sp" android:gravity="center"
                android:padding="14dp" android:inputType="textPersonName"
                android:layout_marginBottom="16dp"/>
            <Button android:id="@+id/proceedBtn" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="شروع کریں"
                android:background="@drawable/btn_green" android:textColor="#FFFFFF"
                android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/statusTv" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:textSize="12sp" android:layout_marginTop="16dp" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>